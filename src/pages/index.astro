<script is:inline>
  const testimonials = [
    {
      text: '"No es un audiolibro convencional. Es una experiencia inmersiva que me hizo reconciliarme con heridas que creía que definirían el resto de mis días."',
      author: '— Carlos M., Psicólogo Clínico'
    },
    {
      text: '"La profundidad de la narración me detuvo en seco. Comencé a escuchar de noche y terminé sintiendo una paz que hacía años no experimentaba."',
      author: '— Elena R., Lectora'
    },
    {
      text: '"Ver a estas figuras históricas despojadas de dogma, viviendo el dolor y las decisiones humanas más hondas, me transformó la mirada."',
      author: '— Andrés G., Arquitecto'
    }
  ];
  let currentTestimonial = 0;
  function updateTestimonialUI() {
    const textEl = document.getElementById('testimonial-text');
    const authorEl = document.getElementById('testimonial-author');
    if (!textEl || !authorEl) return;
    textEl.innerText = testimonials[currentTestimonial].text;
    authorEl.innerText = testimonials[currentTestimonial].author;
    [0, 1, 2].forEach(i => {
      const dot = document.getElementById('dot-' + i);
      if (dot) {
        dot.className = i === currentTestimonial ? 'w-2.5 h-2.5 rounded-full bg-[#E0BB82] transition-colors' : 'w-2.5 h-2.5 rounded-full bg-[#B98A50]/30 transition-colors';
      }
    });
  }
  function nextTestimonial() {
    currentTestimonial = (currentTestimonial + 1) % testimonials.length;
    updateTestimonialUI();
  }
  function prevTestimonial() {
    currentTestimonial = (currentTestimonial - 1 + testimonials.length) % testimonials.length;
    updateTestimonialUI();
  }
</script>

